{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["index.ts", "autotrack.ts", "vite.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "demo", "scripts", "test", "dist", "release"]
}
